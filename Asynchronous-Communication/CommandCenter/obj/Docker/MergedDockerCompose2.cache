name: dockercompose13406436334003705247
services:
  ccui:
    build:
      context: D:\Yogesh\SEO\Yogihosting\new\Microservices-new\Asynchronous-Communication\CommandCenter
      dockerfile: CCUI/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
    image: ccui
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "9000"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "9001"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Avita\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Avita\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Avita\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Avita\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  commandcenter:
    build:
      context: D:\Yogesh\SEO\Yogihosting\new\Microservices-new\Asynchronous-Communication\CommandCenter
      dockerfile: CommandCenter/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
    image: commandcenter
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8000"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Avita\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Avita\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Avita\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Avita\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  mongo:
    container_name: mongo
    image: mongo
    networks:
      default: null
    ports:
      - mode: ingress
        target: 27017
        published: "27017"
        protocol: tcp
    volumes:
      - type: volume
        source: mongodbdata
        target: /data/db
        volume: {}
  rabbitmq:
    container_name: rabbitmq
    hostname: rabbitmq
    image: rabbitmq:management
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5672
        published: "5672"
        protocol: tcp
      - mode: ingress
        target: 15672
        published: "15672"
        protocol: tcp
    volumes:
      - type: volume
        source: rabbitmqdata
        target: /var/lib/rabbitmq
        volume: {}
networks:
  default:
    name: dockercompose13406436334003705247_default
volumes:
  mongodbdata:
    name: dockercompose13406436334003705247_mongodbdata
  rabbitmqdata:
    name: dockercompose13406436334003705247_rabbitmqdata